{
  "expo": {
    "name": "Ei",
    "slug": "ei",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "eimobile",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#050508"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.sogki.ei",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Ei uses your location to answer where you are and look up nearby store hours.",
        "NSCameraUsageDescription": "Ei uses the camera to identify objects and translate text.",
        "NSPhotoLibraryUsageDescription": "Ei can analyse photos you pick for identification or translation."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050508",
        "foregroundImage": "./assets/images/icon.png"
      },
      "package": "dev.sogki.ei",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ei uses your location to answer where you are and look up nearby store hours."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Ei uses the camera to identify objects and translate text.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Ei can analyse photos you pick for identification or translation."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#050508"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d9e088e9-78b4-4ac8-8020-28307625f229"
      }
    },
    "owner": "sogki",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d9e088e9-78b4-4ac8-8020-28307625f229"
    }
  }
}
