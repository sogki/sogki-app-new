# Citadel — Sentinel API (local or Railway)
# Never commit real values.
#
# Railway service name / root: citadel → Root Directory `sentinel`
# See docs/sentinel/citadel-railway.md
#
# With Supabase:
#   1. DATABASE_URL = Supabase Postgres URI
#   2. ADMIN_DEV_TOKEN + ADMIN_JWT_SECRET live in public.keys (loaded on startup)
#   3. Frontend reads SENTINEL_API_URL from keys (set to Railway HTTPS URL in prod)
#
# Offline / SQLite: leave DATABASE_URL empty and set tokens below.

SENTINEL_SERVICE_SECRET=change-me-to-a-long-random-string
DEPLOY_CODENAME=citadel

# SQLite/offline only — ignored when the same values exist in Supabase keys.
SENTINEL_ADMIN_TOKENS=dev-admin-token
ADMIN_JWT_SECRET=

DATABASE_URL=

# Bind (Railway sets PORT automatically)
SENTINEL_HOST=0.0.0.0
PORT=8790

# Comma-separated admin UI origins (defaults already include sogki.dev + local Vite)
# SENTINEL_CORS_ORIGINS=http://localhost:5173,https://sogki.dev

SENTINEL_REQUEST_TIMEOUT_SECONDS=10
SENTINEL_MAX_REDIRECTS=5
SENTINEL_USER_AGENT=SentinelPrivateScanner/1.0 (+personal-lab; non-destructive)
